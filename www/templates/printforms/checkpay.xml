<?xml version="1.0" encoding="windows-1251"?>
<CHECK xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="check01.xsd">

    <CHECKHEAD>

        <DOCTYPE>0</DOCTYPE>
        <DOCSUBTYPE>0</DOCSUBTYPE>

        <UID>{{guid}}</UID>

          {{#tin}}
        <TIN>{{tin}}</TIN>
         {{/tin}}

        {{#inn}}
        <IPN>{{inn}}</IPN>
        {{/inn}}

        <ORGNM>{{firmname}}</ORGNM>

        <POINTNM>{{pointname}}</POINTNM>

        <POINTADDR>{{address}}</POINTADDR>

        <ORDERDATE>{{date}}</ORDERDATE>

        <ORDERTIME>{{time}}</ORDERTIME>

        <ORDERNUM>{{docnumber}}</ORDERNUM>

        <CASHDESKNUM>{{posinner}}</CASHDESKNUM>

        <CASHREGISTERNUM>{{posnumber}}</CASHREGISTERNUM>

        <CASHIER>{{username}}</CASHIER>

        <VER>1</VER>
         {{#testing}}
        <TESTING>1</TESTING>
        {{/testing}}
   </CHECKHEAD>

    <CHECKTOTAL>
        <SUM>{{parentsum}}</SUM>
        <PARTPAYTYPE>{{partpaytype}}</PARTPAYTYPE>
        <PARTPAYSUM>{{partpaysum}}</PARTPAYSUM>
        <PARTPAYORDPREPAYNUM>{{parentcheck}}</PARTPAYORDPREPAYNUM>
      
    </CHECKTOTAL>
  
    <CHECKPAY>
        <ROW ROWNUM="1">

            <PAYFORMCD>{{formcode}}</PAYFORMCD>

            <PAYFORMNM>{{formname}}</PAYFORMNM>

            <SUM>{{partpaysum}}</SUM>

        </ROW>
    </CHECKPAY>
    <CHECKBODY>
     <ROW ROWNUM="1">
  
      <NAME>Часткова оплата</NAME>
 
      <AMOUNT>1.000</AMOUNT>
      <PRICE>{{parentsum}}</PRICE>
      <COST>{{parentsum}}</COST>
      <PARTPAYSUM>{{partpaysum}}</PARTPAYSUM>
    </ROW>
    </CHECKBODY>
</CHECK>
